CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52833_QIAA=y
CONFIG_BOARD_DWM3001C_CUSTOM=y

# Enable MPU
CONFIG_ARM_MPU=y

# Enable hardware stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable GPIO
CONFIG_GPIO=y

# Enable UART driver
CONFIG_SERIAL=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# IMPORTANT: Do NOT enable APPROTECT — ST-Link V2 cannot recover
# a locked nRF52833. See docs/HARDWARE_TEST.md.
# CONFIG_NRF_APPROTECT_LOCK is intentionally NOT set.
